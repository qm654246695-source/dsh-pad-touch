+    def _handle_triggers(self, l2: int, r2: int, now: float) -> None:
+        """扣扳机 = 摸一下。
+
+        按下记起点，松开时按"按了多久"落定成一条触摸事件（手势记作 stroke）。
+        这样扳机和触摸板走同一条出口，插件不用为它单开代码。
+        """
+        for side, value, attr in (("左", l2, "_l2_down"), ("右", r2, "_r2_down")):
+            down = getattr(self, attr)
+            if down is None:
+                if value >= TRIGGER_DOWN:
+                    setattr(self, attr, now)
+                continue
+            if value > TRIGGER_UP:
+                continue
+            setattr(self, attr, None)
+            duration = max(0.0, now - down)
+            if duration < 0.05:
+                continue
+            event = {
+                "type": "touch",
+                "gesture": "stroke",
+                # 扣哪只手就记哪只手：左扳机 = 左手，右扳机 = 右手
+                "zone": "左手" if side == "左" else "右手",
+                "nx": 0.0,
+                "ny": 0.0,
+                "at": time.time(),
+                "dur": round(duration, 3),
+                "path": 0.0,
+                "speed": 0.0,
+                "span": 0.0,
+                "turns": 0.0,
+                "trigger": side,
+            }
+            with self._lock:
+                self._state.update(gesture="stroke", gestureAt=event["at"])
+            with self._events_lock:
+                self._events.append(event)
+                del self._events[: -self.config.event_buffer]
+            print("[pad] 扳机%s %.1fs" % (side, duration), flush=True)
+            try:
+                apply_reaction(self.haptics, "stroke")
+            except Exception as exc:
+                print("[pad] 反馈失败：%s" % exc, flush=True)
+            self._dispatch(event)
