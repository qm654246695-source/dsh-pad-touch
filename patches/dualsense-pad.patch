+def ramp_effect(start_force: int, end_force: int) -> bytes:
+    """构造一个「随行程变重」的扳机效果（0x21 分区阻力 + 三段力度）。
+
+    2026-11-08 实测确认：Resistance 帧的 ``[3][4][5]`` 是**按行程分三段的力度**，
+    76 / 127 / 178 的手感就是三成 → 五成 → 七成（用户确认「力度对的」）。
+    ``[1][2]`` 是哪些位置参与的位掩码，全开 = ``0xFF, 0x03``。
+    """
+    b = bytearray(11)
+    b[0] = 0x21
+    b[1] = 0xFF
+    b[2] = 0x03
+    b[3] = _clamp8(start_force)
+    b[4] = _clamp8((int(start_force) + int(end_force)) // 2)
+    b[5] = _clamp8(end_force)
+    return bytes(b)
+
+
+def _pad11(value: bytes) -> bytes:
+    """把扳机效果补齐到 11 字节。"""
+    b = bytearray(11)
+    b[: min(11, len(value))] = value[:11]
+    return bytes(b)
+
